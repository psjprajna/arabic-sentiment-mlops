# Build-context exclusions for the runtime image.
# Keep the context small so HF Spaces builds stay fast.

# MLflow state. Phase 10c pulls the deploy bundle (LoRA weights, mlflow.db,
# logged-model subtree) from HF Hub at build time — none of this is read
# from the local build context any more, so the blanket exclusion is
# sufficient and the Phase-10b parent-walk re-includes are dropped.
mlruns/
mlruns-legacy.bak/
mlflow.db
mlflow.db-journal

# Training artefacts not part of the LoRA serving path.
catboost_info/
models/catboost-baseline-v1/

# Datasets + reports stay out of the image; drift reference is not baked
# in this slice (signals will be `reference_missing: true` at /metrics/drift).
data/
reports/
reports-legacy.bak/

# Tests and local docs.
tests/
docs/

# Python build/run cruft.
.venv/
__pycache__/
**/__pycache__/
.pytest_cache/
*.egg-info/
.ruff_cache/

# Git + IDE.
.git/
.gitignore
.github/
.vscode/
.idea/

# Container files (not needed inside the image itself).
Dockerfile
.dockerignore
