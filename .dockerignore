# Build-context exclusions for the runtime image.
# Keep the context small so HF Spaces builds stay fast.

# MLflow state. Phase 10b bakes mlflow.db plus ONE logged-model subtree
# (the arabert-lora v1 pyfunc bundle, ~523 MB) so the in-container registry
# resolves at startup and /health.model_version is populated. Everything
# else under mlruns/ stays out of the image. The parent-walk negation is
# required because .dockerignore does not recurse into an excluded dir.
mlruns/
mlruns-legacy.bak/
mlflow.db
mlflow.db-journal
!mlflow.db
!mlruns/
!mlruns/1/
!mlruns/1/models/
!mlruns/1/models/m-f9cac40424504a5a91d9449f38f5bd7c/
!mlruns/1/models/m-f9cac40424504a5a91d9449f38f5bd7c/**

# Training artefacts not part of the LoRA serving path.
catboost_info/
models/catboost-baseline-v1/

# Datasets + reports stay out of the image; drift reference is not baked
# in this slice (signals will be `reference_missing: true` at /metrics/drift).
data/
reports/
reports-legacy.bak/

# Tests and local docs.
tests/
docs/

# Python build/run cruft.
.venv/
__pycache__/
**/__pycache__/
.pytest_cache/
*.egg-info/
.ruff_cache/

# Git + IDE.
.git/
.gitignore
.github/
.vscode/
.idea/

# Container files (not needed inside the image itself).
Dockerfile
.dockerignore
